@{
    var userName = Context.Session.GetString("UserName");
}

<ul class="navbar-nav">
@if (!string.IsNullOrEmpty(userName))
{
    <li class="nav-item">
        <span class="nav-link text-light">Hello @userName!</span>
    </li>
    <li class="nav-item">
        <form method="post" asp-page="/Logout">
            <button type="submit" class="nav-link btn btn-link text-light border-0">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-light" asp-page="/Login">Login</a>
    </li>
}
</ul>