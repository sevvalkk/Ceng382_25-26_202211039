
@page
@model Project.Pages.IndexModel

@{
    // Example: redirect to login if not authenticated
    var isAuthenticated = HttpContext.Session.GetString("UserName") != null;
    if (!isAuthenticated)
    {
        Response.Redirect("/Login");
    }
}


